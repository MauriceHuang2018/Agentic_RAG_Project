# Vite env for src/web/ frontend.
# Copy to .env.local for local dev. .env* is gitignored at repo root.

# Backend FastAPI base URL (proxied via vite.config.ts → localhost:8000 by default)
VITE_API_BASE_URL=/api/v1
VITE_API_PORT=8000

# App identity
VITE_APP_TITLE=Agentic RAG · DocGPT
VITE_APP_DEFAULT_LOCALE=zh-CN

# Feature flags
VITE_DEMO_MODE=false
VITE_ENABLE_CHAT_STREAM=true

# JWT / auth (frontend only — backend JWT_SECRET stays in backend .env)
VITE_JWT_STORAGE_KEY=agentic_rag_token
VITE_JWT_USER_STORAGE_KEY=agentic_rag_user