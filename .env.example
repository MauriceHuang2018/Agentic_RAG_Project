# Application
APP_ENV=development
APP_PORT=8000
APP_LOG_LEVEL=INFO
APP_NAME=agentic-rag

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Business schema (17 tables, Alembic-managed)
POSTGRES_DB=rag_business
# LiteLLM metadata schema (Prisma-managed, auto-created on first start)
POSTGRES_LITELLM_DB=rag_litellm
POSTGRES_USER=rag
POSTGRES_PASSWORD=__FROM_SECRET__

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=__FROM_SECRET__
# DB 0 — app embedding cache (embed:cache:*)
REDIS_DB=0
# DB 4 — conversation history (conv:history:*), isolated from cache
REDIS_HISTORY_DB=4

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=__FROM_SECRET__
QDRANT_COLLECTION=chunks_v1
QDRANT_VECTOR_DIM=1024

# LiteLLM (model gateway)
LITELLM_BASE_URL=http://localhost:4000
LITELLM_MASTER_KEY=__FROM_SECRET__
LITELLM_API_KEY=__FROM_SECRET__
LITELLM_MODEL=openai/qwen3.5-plus
LITELLM_FALLBACK_MODELS=openai/deepseek-v4-flash-0731
# Long-context fallback (DESIGN 4.4)
LITELLM_LONG_CONTEXT_MODEL=openai/deepseek-v4-flash-0731
LITELLM_LONG_CONTEXT_THRESHOLD=0.5

# ===== Chat LLM call-site optimization (2026-09-05) =====
# Default: thinking OFF for direct synth + classifier (kill qwen3.7-plus
# reasoning trace → drops 74s → ≤ 20s on real RAG prompts). Agent path
# keeps thinking ON (complex multi-hop benefits from reasoning).
# LiteLLM pass-through for extra_body to DashScope is ~62% reliable; the
# probe at deploy time confirms whether these knobs actually land.
DIRECT_SYNTH_MAX_TOKENS=1024
DIRECT_SYNTH_ENABLE_THINKING=false
CLASSIFIER_MAX_TOKENS=200
CLASSIFIER_ENABLE_THINKING=false
AGENT_SYNTH_MAX_TOKENS=1024
AGENT_SYNTH_ENABLE_THINKING=true

# M5 S2 (HIGH) — DashScope API key MUST be set; docker-compose.yml
# uses `${DASHSCOPE_API_KEY:?...}` and will refuse to start otherwise.
# Get yours at https://dashscope.console.aliyun.com/apiKey
DASHSCOPE_API_KEY=__FROM_SECRET__
Ali_API_BASE_URL=https://llm-hnrsol3p3ygnxms0.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# embedding model base URL
# Ali_EMBEDDING_BASE_URL=https://llm-hnrsol3p3ygnxms0.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
dashscope_workspace_id=llm-hnrsol3p3ygnxms0

# RAGFlow DeepDoc Server (independent LitServe, port 9390 by default).
# Only invoked for scanned/complex PDFs and standalone images via the
# visual_router; structured formats (PDF text / DOCX / PPTX / XLSX / MD / TXT)
# are parsed in-process with pip libraries (pymupdf / python-docx / etc.).
RAGFLOW_BASE_URL=http://localhost:9390
RAGFLOW_API_KEY=__FROM_SECRET__
# DeepDoc Server exposed port (matches docker-compose.yml).
DEEPDOC_PORT=9390
# RapidOCR local fallback (no separate container needed).
RAPIDOCR_FALLBACK_ENABLED=true
# PDF scanner heuristic — pages with fewer avg chars are routed to DeepDoc.
PDF_SCANNED_AVG_CHARS_THRESHOLD=100

# Local file storage (private deployment, no S3)
STORAGE_ROOT=./data/documents
STORAGE_MAX_UPLOAD_MB=50

# Observability stack ports (M5 S4): exposed by docker-compose for
# the host. M5 hardening means grafana's admin password MUST be set
# (no more silent `admin` default). The CI guard refuses a deploy
# that left GRAFANA_ADMIN_PASSWORD unset.
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=__FROM_SECRET__

# JWT
JWT_SECRET=__FROM_SECRET__
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Two-stage retrieval (DESIGN 4.4)
TWO_STAGE_PARENT_TOP_K=3
TWO_STAGE_CHILD_TOP_K=10

# Evaluation & Drift
EVAL_ENABLED=true
DRIFT_WINDOW_DAYS=7
DRIFT_THRESHOLD=0.05

# Observability — T4.3 Prometheus exposition
# `METRICS_ALLOWED_CIDRS` is a comma-joined list of CIDR ranges
# allowed to scrape /metrics. Loopback (127.0.0.0/8 + ::1/128) is
# always allowed; this list adds extra ranges (e.g. the Prometheus
# subnet in production).
METRICS_ALLOWED_CIDRS=
# `METRICS_BEARER_TOKEN` — when set, requires `Authorization: Bearer
# <token>` for ALL non-loopback callers. Leave empty in dev for
# loopback-only access; rotate quarterly in prod.
METRICS_BEARER_TOKEN=
# Multiprocess collector (gunicorn multi-worker scrapes share state
# through this directory). Required for production; leave empty for
# single-process dev.
PROMETHEUS_MULTIPROC_DIR=

# Demo accounts (M6 — see src/agentic_rag_project/rbac/seed.py:_ensure_demo_data).
# Operated by user 2026-09-01 to make /chat verifiable without manually wiring
# every workspace binding. Defaults match the names in code; override here to
# rotate passwords without editing source.
DEMO_ALICE_PASSWORD=alice_pass
DEMO_BOB_PASSWORD=bob_pass
DEMO_ADMIN_PASSWORD=admin_pass
# Grafana admin (docker-compose.yml:323 enforces this via `${...:?}`).
# Set 2026-09-01 to unblock `docker compose build` / `up` after adding
# the grafana service. Local-dev only — rotate for prod.
GRAFANA_ADMIN_PASSWORD=admin_pass